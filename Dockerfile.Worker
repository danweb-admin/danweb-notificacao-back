
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY . .

RUN dotnet restore DanWeb.Notificacoes.sln

RUN dotnet publish src/DanWeb.Notificacoes.Worker/DanWeb.Notificacoes.Worker.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0

WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "DanWeb.Notificacoes.Worker.dll"]
